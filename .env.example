# Vorlage. Kopieren nach .env und dort ausfüllen. Die Datei .env kommt nie ins Repo.

# Börse (Binance). API-Schlüssel nur mit Handelsrecht, OHNE Auszahlungsrecht,
# und nur von der IP-Adresse des Servers nutzbar.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram: Meldungen zu jedem Trade und Not-Aus mit /stop
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
